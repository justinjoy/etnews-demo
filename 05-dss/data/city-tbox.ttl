    rdfs:range  xsd:decimal .

ex:air_idx_main a owl:DatatypeProperty ;
    rdfs:domain ex:WeatherStatus ;
    rdfs:range  xsd:string .

ex:air_msg a owl:DatatypeProperty ;
    rdfs:domain ex:WeatherStatus ;
    rdfs:range  xsd:string .

ex:pcp_msg a owl:DatatypeProperty ;
    rdfs:domain ex:WeatherStatus ;
    rdfs:range  xsd:string .

ex:wind_dirct a owl:DatatypeProperty ;
    rdfs:domain ex:WeatherStatus ;
    rdfs:range  xsd:string .

ex:wind_spd a owl:DatatypeProperty ;
    rdfs:domain ex:WeatherStatus ;
    rdfs:range  xsd:decimal .

# WeatherForecast 전용
ex:rain_chance a owl:DatatypeProperty ;
    rdfs:domain ex:WeatherForecast ;
    rdfs:range  xsd:integer .

ex:sky_stts a owl:DatatypeProperty ;
    rdfs:domain ex:WeatherForecast ;
    rdfs:range  xsd:string .


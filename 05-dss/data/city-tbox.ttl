@prefix ex:  <http://k.fc/onto/city#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

#################################################################
# Ontology header
#################################################################

ex:CityDataOntology a owl:Ontology ;
    rdfs:label "Seoul City Data Ontology"@en ;
    rdfs:comment "서울 실시간 도시데이터(citydata)를 표현하기 위한 온톨로지 TBox (강남역 예시 ABox 기반)."@ko .

#################################################################
# 상위 개념 클래스 계층
#################################################################

ex:Entity a owl:Class ;
    rdfs:label "Entity"@en .

ex:SpatialEntity a owl:Class ;
    rdfs:subClassOf ex:Entity ;
    rdfs:label "Spatial entity"@en ;
    rdfs:comment "공간적 위치를 가지는 모든 물리 객체"@ko .

ex:Facility a owl:Class ;
    rdfs:subClassOf ex:SpatialEntity ;
    rdfs:label "Facility"@en .

ex:TransportationFacility a owl:Class ;
    rdfs:subClassOf ex:Facility ;
    rdfs:label "Transportation facility"@en .

ex:NetworkElement a owl:Class ;
    rdfs:subClassOf ex:SpatialEntity ;
    rdfs:label "Network element"@en .

ex:Observation a owl:Class ;
    rdfs:subClassOf ex:Entity ;
    rdfs:label "Observation"@en .

ex:Status a owl:Class ;
    rdfs:subClassOf ex:Observation ;
    rdfs:label "Status"@en ;
    rdfs:comment "특정 시점의 상태를 나타내는 개체"@ko .

ex:Forecast a owl:Class ;
    rdfs:subClassOf ex:Observation ;
    rdfs:label "Forecast"@en ;
    rdfs:comment "미래 상태에 대한 예측 정보를 나타내는 개체"@ko .

ex:Message a owl:Class ;
    rdfs:subClassOf ex:Entity ;
    rdfs:label "Message"@en .

#################################################################
# 도메인별 클래스 정의
#################################################################

ex:Area a owl:Class ;
    rdfs:subClassOf ex:SpatialEntity , geo:Feature ;
    rdfs:label "Area"@en ;
    rdfs:comment "서울 시내 주요 장소(POI 단위 영역)"@ko .

ex:CityDataObservation a owl:Class ;
    rdfs:subClassOf ex:Observation ;
    rdfs:label "City data observation"@en .

# Status 계층
ex:PopulationStatus a owl:Class ;
    rdfs:subClassOf ex:Status ;
    rdfs:label "Population status"@en .

ex:CommercialStatus a owl:Class ;
    rdfs:subClassOf ex:Status ;
    rdfs:label "Commercial status"@en .

ex:RoadTrafficSummary a owl:Class ;
    rdfs:subClassOf ex:Status ;
    rdfs:label "Road traffic summary"@en .

ex:BusPopulationStatus a owl:Class ;
    rdfs:subClassOf ex:Status ;
    rdfs:label "Bus population status"@en .

ex:SubwayPopulationStatus a owl:Class ;
    rdfs:subClassOf ex:Status ;
    rdfs:label "Subway population status"@en .

ex:WeatherStatus a owl:Class ;
    rdfs:subClassOf ex:Status ;
    rdfs:label "Weather status"@en .

# Forecast 계층
ex:PopulationForecast a owl:Class ;
    rdfs:subClassOf ex:Forecast ;
    rdfs:label "Population forecast"@en .

ex:WeatherForecast a owl:Class ;
    rdfs:subClassOf ex:Forecast ;
    rdfs:label "Weather forecast"@en .

# 상권 업종별 세부
ex:CommercialSectorStatus a owl:Class ;
    rdfs:subClassOf ex:Observation ;
    rdfs:label "Commercial sector status"@en .

# 메시지
ex:DisturbanceMessage a owl:Class ;
    rdfs:subClassOf ex:Message ;
    rdfs:label "Disturbance message"@en .

# 교통/인프라
ex:SubwayStation a owl:Class ;
    rdfs:subClassOf ex:TransportationFacility , geo:Feature ;
    rdfs:label "Subway station"@en .

ex:BusStop a owl:Class ;
    rdfs:subClassOf ex:TransportationFacility , geo:Feature ;
    rdfs:label "Bus stop"@en .

ex:BikeStation a owl:Class ;
    rdfs:subClassOf ex:TransportationFacility , geo:Feature ;
    rdfs:label "Bike sharing station"@en .

ex:ParkingLot a owl:Class ;
    rdfs:subClassOf ex:Facility , geo:Feature ;
    rdfs:label "Parking lot"@en .

ex:EVChargerStation a owl:Class ;
    rdfs:subClassOf ex:Facility , geo:Feature ;
    rdfs:label "EV charger station"@en .

ex:EVCharger a owl:Class ;
    rdfs:subClassOf ex:Entity ;
    rdfs:label "EV charger"@en .

# 도로 네트워크
ex:RoadNode a owl:Class ;
    rdfs:subClassOf ex:NetworkElement , geo:Feature ;
    rdfs:label "Road node"@en .

ex:RoadLink a owl:Class ;
    rdfs:subClassOf ex:NetworkElement , geo:Feature ;
    rdfs:label "Road link"@en .

#################################################################
# Object properties
#################################################################

ex:observedArea a owl:ObjectProperty ;
    rdfs:domain ex:CityDataObservation ;
    rdfs:range  ex:Area .

ex:hasPopulationStatus a owl:ObjectProperty ;
    rdfs:domain ex:Area ;
    rdfs:range  ex:PopulationStatus .

ex:hasCommercialStatus a owl:ObjectProperty ;
    rdfs:domain ex:Area ;
    rdfs:range  ex:CommercialStatus .

ex:hasRoadTrafficSummary a owl:ObjectProperty ;
    rdfs:domain ex:Area ;
    rdfs:range  ex:RoadTrafficSummary .

ex:hasBusPopulationStatus a owl:ObjectProperty ;
    rdfs:domain ex:Area ;
    rdfs:range  ex:BusPopulationStatus .

ex:hasSubwayPopulationStatus a owl:ObjectProperty ;
    rdfs:domain ex:Area ;
    rdfs:range  ex:SubwayPopulationStatus .

ex:hasWeatherStatus a owl:ObjectProperty ;
    rdfs:domain ex:Area ;
    rdfs:range  ex:WeatherStatus .

ex:hasDisturbanceMessage a owl:ObjectProperty ;
    rdfs:domain ex:Area ;
    rdfs:range  ex:DisturbanceMessage .

ex:hasSubwayStation a owl:ObjectProperty ;
    rdfs:domain ex:Area ;
    rdfs:range  ex:SubwayStation .

ex:hasBusStop a owl:ObjectProperty ;
    rdfs:domain ex:Area ;
    rdfs:range  ex:BusStop .

ex:hasBikeStation a owl:ObjectProperty ;
    rdfs:domain ex:Area ;
    rdfs:range  ex:BikeStation .

ex:hasParkingLot a owl:ObjectProperty ;
    rdfs:domain ex:Area ;
    rdfs:range  ex:ParkingLot .

ex:hasEVChargerStation a owl:ObjectProperty ;
    rdfs:domain ex:Area ;
    rdfs:range  ex:EVChargerStation .

ex:hasRoadLink a owl:ObjectProperty ;
    rdfs:domain ex:Area ;
    rdfs:range  ex:RoadLink .

ex:hasEVCharger a owl:ObjectProperty ;
    rdfs:domain ex:EVChargerStation ;
    rdfs:range  ex:EVCharger .

ex:hasSectorStatus a owl:ObjectProperty ;
    rdfs:domain ex:CommercialStatus ;
    rdfs:range  ex:CommercialSectorStatus .

ex:hasPopulationForecast a owl:ObjectProperty ;
    rdfs:domain ex:PopulationStatus ;
    rdfs:range  ex:PopulationForecast .

ex:hasWeatherForecast a owl:ObjectProperty ;
    rdfs:domain ex:WeatherStatus ;
    rdfs:range  ex:WeatherForecast .

ex:startNode a owl:ObjectProperty ;
    rdfs:domain ex:RoadLink ;
    rdfs:range  ex:RoadNode .

ex:endNode a owl:ObjectProperty ;
    rdfs:domain ex:RoadLink ;
    rdfs:range  ex:RoadNode .

#################################################################
# Data properties (공통)
#################################################################

ex:observedAt a owl:DatatypeProperty ;
    rdfs:domain ex:Observation ;
    rdfs:range  xsd:dateTime .

ex:areaCode a owl:DatatypeProperty ;
    rdfs:domain ex:Area ;
    rdfs:range  xsd:string .

